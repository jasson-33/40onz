{%- comment -%}
  Product card snippet.
  Expects: product (product object), show_vendor (bool), lazy (bool),
  hide_info (bool — skip title/price block)
{%- endcomment -%}

{%- liquid
  assign featured_image = product.featured_media
  assign hover_image = product.media[1]
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}

<article
  data-product-card
  class="group relative flex flex-col"
  aria-label="{{ product.title | escape }}"
>
  {%- comment -%} Image container {%- endcomment -%}
  <div class="relative block overflow-hidden bg-white">
    <a href="{{ product.url }}" class="block" tabindex="-1" aria-hidden="true">
      <span class="absolute top-4 right-4 z-10 text-white/70 text-base leading-none pointer-events-none">✶</span>
    {%- if featured_image -%}
      <img
        data-img-primary
        src="{{ featured_image | image_url: width: 600 }}"
        srcset="
          {{ featured_image | image_url: width: 400 }} 400w,
          {{ featured_image | image_url: width: 600 }} 600w,
          {{ featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
        alt="{{ featured_image.alt | escape | default: product.title | escape }}"
        width="{{ featured_image.preview_image.width }}"
        height="{{ featured_image.preview_image.height }}"
        loading="{{ loading }}"
        class="block w-full h-auto transition-opacity duration-300"
      >
    {%- endif -%}

    {%- if hover_image -%}
      <img
        data-img-hover
        src="{{ hover_image | image_url: width: 600 }}"
        srcset="
          {{ hover_image | image_url: width: 400 }} 400w,
          {{ hover_image | image_url: width: 600 }} 600w,
          {{ hover_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
        alt="{{ hover_image.alt | escape | default: product.title | escape }}"
        width="{{ hover_image.preview_image.width }}"
        height="{{ hover_image.preview_image.height }}"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-contain bg-white opacity-0 transition-opacity duration-300"
      >
    {%- endif -%}
    </a>

    {%- comment -%} Quick-add button {%- endcomment -%}
    {%- if product.available -%}
      <div class="absolute z-10 bottom-0 left-3 right-3 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
        {%- if product.variants.size == 1 -%}
          <form action="{{ routes.cart_add_url }}" method="post" data-add-to-cart>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              class="w-full py-3 bg-white text-[#0a0a0a] text-[10px] tracking-[0.18em] uppercase font-medium hover:bg-[#f1f1f1] transition-colors duration-200"
            >
              Quick Add
            </button>
          </form>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="block w-full py-3 bg-white text-[#0a0a0a] text-[10px] tracking-[0.18em] uppercase font-medium text-center hover:bg-[#f1f1f1] transition-colors duration-200"
          >
            Select Options
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="absolute z-10 bottom-0 left-3 right-3">
        <span class="block w-full py-3 bg-[#2a2a2a] text-[#b0b0b0] text-[10px] tracking-[0.18em] uppercase text-center">
          Sold Out
        </span>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Card info {%- endcomment -%}
  {%- unless hide_info -%}
  <div class="pt-3 flex flex-col gap-1 text-[#111]">
    {%- if show_vendor and product.vendor -%}
      <p class="text-xs text-[#6b6b6b] tracking-widest uppercase">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="text-[10px] font-medium leading-snug tracking-[0.08em] uppercase">
      <a href="{{ product.url }}" class="hover:text-[#6b6b6b] transition-colors duration-200">
        {{ product.title }}
      </a>
    </h3>

    <p class="text-[10px] text-[#6b6b6b] tracking-[0.06em] uppercase">
      {%- if product.price_varies -%}
        <span>From </span>
      {%- endif -%}
      <span class="{% if product.compare_at_price > product.price %}text-red-400{% endif %}">
        {{ product.price | money }}
      </span>
      {%- if product.compare_at_price > product.price -%}
        <s class="text-[#6b6b6b] ml-1">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </p>
  </div>
  {%- endunless -%}
</article>
