{%- comment -%}
  Bespoke — banner under the fixed header, then an editorial
  workshop page. Blocks render in order: 'heading' small
  uppercase label, 'paragraph' serif body text, 'media_band'
  full-bleed video/image, 'media_row' three portrait cells,
  'appointment' text + CTA left / media right (bleeds to edge).
{%- endcomment -%}

{%- liquid
  assign banner_height = section.settings.banner_height | default: 75
-%}

<section class="bg-white text-ink overflow-x-clip">
  {%- comment -%} ── Banner (under fixed header) ─────────────────────── {%- endcomment -%}
  <div
    class="relative w-full overflow-hidden bg-black"
    style="height: {{ banner_height }}vh; min-height: 420px; margin-top: calc(-1 * var(--header-h, 140px));"
  >
    {%- if section.settings.video != blank -%}
      <video
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 2000 }}"
        {% endif %}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
      >
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif section.settings.video_url != blank -%}
      {%- assign banner_video_url = section.settings.video_url -%}
      {%- if banner_video_url contains 'youtube.com' or banner_video_url contains 'youtu.be' -%}
        {%- liquid
          if banner_video_url contains 'youtu.be/'
            assign yt_id = banner_video_url | split: 'youtu.be/' | last | split: '?' | first
          elsif banner_video_url contains 'youtube.com/watch?v='
            assign yt_id = banner_video_url | split: 'v=' | last | split: '&' | first
          elsif banner_video_url contains 'youtube.com/shorts/'
            assign yt_id = banner_video_url | split: 'shorts/' | last | split: '?' | first
          endif
        -%}
        <iframe
          src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&modestbranding=1&playsinline=1&rel=0&fs=0&disablekb=1&iv_load_policy=3&enablejsapi=1"
          allow="autoplay; encrypted-media"
          allowfullscreen
          frameborder="0"
          aria-hidden="true"
          tabindex="-1"
          class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        ></iframe>
      {%- elsif banner_video_url contains 'vimeo.com' -%}
        {%- assign vimeo_id = banner_video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
        <iframe
          src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&autopause=0&controls=0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          frameborder="0"
          aria-hidden="true"
          tabindex="-1"
          class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        width="2000"
        height="1125"
        alt="{{ section.settings.image.alt | escape | default: 'Bespoke atelier' }}"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center"
      >
    {%- elsif section.settings.asset != blank -%}
      <img
        src="{{ section.settings.asset | asset_url }}"
        width="1920"
        height="810"
        alt="Bespoke atelier"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center"
      >
    {%- endif -%}

    <div
      class="absolute inset-0 bg-black"
      style="opacity: {{ section.settings.overlay_opacity | default: 10 | divided_by: 100.0 }};"
    ></div>
  </div>

  {%- comment -%} ── Blocks ───────────────────────────────────────────── {%- endcomment -%}
  <div class="flex flex-col gap-16 lg:gap-24 pt-16 pb-20 lg:pt-20 lg:pb-28">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <h2 class="font-acumin text-[26.67px] uppercase tracking-wider leading-8 font-light text-ash">
              {{ block.settings.heading }}
            </h2>
          </div>

        {%- when 'paragraph' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <div class="font-acumin [font-weight:194.29] text-ink text-[21px] leading-[25.2px] tracking-wider space-y-5">
              {{ block.settings.body }}
            </div>
          </div>

        {%- when 'media_band' -%}
          <div
            class="relative w-full overflow-hidden bg-black"
            style="height: min({{ block.settings.height | default: 810 }}px, 60vw);"
            {{ block.shopify_attributes }}
          >
            {%- render 'ambient-media',
              video: block.settings.video,
              video_url: block.settings.video_url,
              image: block.settings.image,
              asset: block.settings.asset,
              image_url: block.settings.image_url,
              alt: 'Bespoke',
              sizes: '100vw'
            -%}
          </div>

        {%- when 'media_row' -%}
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 lg:gap-16" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign video_key = 'video_' | append: i -%}
              {%- assign video_url_key = 'video_url_' | append: i -%}
              {%- assign image_key = 'image_' | append: i -%}
              {%- assign asset_key = 'asset_' | append: i -%}
              {%- assign image_url_key = 'image_url_' | append: i -%}
              <div class="relative aspect-[3/4] overflow-hidden bg-black">
                {%- render 'ambient-media',
                  video: block.settings[video_key],
                  video_url: block.settings[video_url_key],
                  image: block.settings[image_key],
                  asset: block.settings[asset_key],
                  image_url: block.settings[image_url_key],
                  alt: 'Bespoke',
                  sizes: '(min-width: 1024px) 33vw, 90vw'
                -%}
              </div>
            {%- endfor -%}
          </div>

        {%- when 'appointment' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10 mt-2 lg:mt-12" {{ block.shopify_attributes }}>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-stretch">
              <div class="flex flex-col gap-8 lg:gap-10">
                {%- if block.settings.heading != blank -%}
                  <h2 class="font-acumin text-[26.67px] uppercase tracking-wider leading-8 font-light text-ash">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="font-acumin [font-weight:194.29] text-ink text-[21px] leading-[25.2px] tracking-wider space-y-5">
                    {{ block.settings.body }}
                  </div>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <a
                    href="{{ block.settings.cta_url | default: '#' }}"
                    class="mt-auto pt-8 lg:pt-12 font-acumin text-2xl font-light text-ash underline-offset-4 hover:underline w-fit"
                  >
                    {{ block.settings.cta_label }}
                  </a>
                {%- endif -%}
              </div>
              <div class="lg:col-span-2 relative overflow-hidden bg-[#f0f0f0] min-h-[320px] lg:min-h-[500px] lg:-mr-[calc(2.5rem+max(0px,(100vw-1800px)/2))]">
                {%- render 'ambient-media',
                  video: block.settings.video,
                  video_url: block.settings.video_url,
                  image: block.settings.image,
                  asset: block.settings.asset,
                  image_url: block.settings.image_url,
                  alt: 'Bespoke appointment',
                  sizes: '(min-width: 1024px) 60vw, 100vw'
                -%}
              </div>
            </div>
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bespoke",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Banner video",
      "info": "Shopify-hosted video. Takes priority over video URL and image."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Fallback if no Shopify-hosted video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (fallback / poster)"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Theme asset filename",
      "info": "e.g. bespoke-banner.jpg — served from assets/ via asset_url"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Banner height",
      "default": 75
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Banner overlay opacity",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Bespoke"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
        }
      ]
    },
    {
      "type": "media_band",
      "name": "Media band (full-bleed)",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Shopify-hosted video. Takes priority over video URL and image."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Fallback if no Shopify-hosted video is set."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset filename",
          "info": "e.g. bespoke-torch.jpg — served from assets/ via asset_url"
        },
        { "type": "url", "id": "image_url", "label": "Image URL (fallback)" },
        {
          "type": "range",
          "id": "height",
          "min": 200,
          "max": 1200,
          "step": 10,
          "unit": "px",
          "label": "Height",
          "default": 810
        }
      ]
    },
    {
      "type": "media_row",
      "name": "Media row (3-up)",
      "settings": [
        { "type": "video", "id": "video_1", "label": "Video 1" },
        {
          "type": "video_url",
          "id": "video_url_1",
          "label": "Video URL 1",
          "accept": ["youtube", "vimeo"]
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "asset_1", "label": "Asset filename 1" },
        { "type": "url", "id": "image_url_1", "label": "Image URL 1 (fallback)" },
        { "type": "video", "id": "video_2", "label": "Video 2" },
        {
          "type": "video_url",
          "id": "video_url_2",
          "label": "Video URL 2",
          "accept": ["youtube", "vimeo"]
        },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "asset_2", "label": "Asset filename 2" },
        { "type": "url", "id": "image_url_2", "label": "Image URL 2 (fallback)" },
        { "type": "video", "id": "video_3", "label": "Video 3" },
        {
          "type": "video_url",
          "id": "video_url_3",
          "label": "Video URL 3",
          "accept": ["youtube", "vimeo"]
        },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "text", "id": "asset_3", "label": "Asset filename 3" },
        { "type": "url", "id": "image_url_3", "label": "Image URL 3 (fallback)" }
      ]
    },
    {
      "type": "appointment",
      "name": "Book an appointment",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Book an appointment"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Select a Date & Time"
        },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Shopify-hosted video. Takes priority over video URL and image."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"]
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset filename",
          "info": "e.g. bespoke-appointment.jpg — served from assets/ via asset_url"
        },
        { "type": "url", "id": "image_url", "label": "Image URL (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bespoke",
      "blocks": [
        { "type": "heading" },
        { "type": "paragraph" },
        { "type": "media_band" },
        { "type": "paragraph" },
        { "type": "media_row" },
        { "type": "paragraph" },
        { "type": "appointment" }
      ]
    }
  ]
}
{% endschema %}
