{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
-%}

<section class="py-16 px-6 lg:px-10 max-w-[1920px] mx-auto bg-white text-[#111]" data-collection-count="{{ collection.products_count }}">
  <div class="flex flex-wrap justify-between items-center gap-6 mb-10">
    <h1 class="font-display text-5xl md:text-6xl font-light uppercase">{{ collection.title }}</h1>
    <div class="flex items-center gap-6">
      <p class="text-[#6b6b6b] text-sm tracking-[0.08em] uppercase">{{ collection.products_count }} products</p>
      {%- if collection.filters.size > 0 -%}
        <details class="relative">
          <summary class="cursor-pointer list-none px-4 py-2 border border-[#c9a96e] text-xs tracking-widest uppercase text-[#c9a96e]">+ Filter</summary>
          <div class="absolute right-0 top-full z-30 w-64 p-6 bg-white border border-[#e5e5e5] shadow-lg">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' -%}
                <h2 class="text-xs tracking-widest uppercase mb-3">{{ filter.label }}</h2>
                {%- for value in filter.values -%}
                  <a class="block py-2 text-sm hover:underline {% if value.active %}font-bold{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}">
                    {{ value.label }} ({{ value.count }})
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </details>
      {%- endif -%}
    </div>
  </div>

  {%- paginate collection.products by products_per_page -%}
    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6 mb-12" data-collection-grid>
      {%- for product in collection.products -%}
        {%- assign card_lazy = true -%}
        {%- if forloop.index <= 4 -%}{%- assign card_lazy = false -%}{%- endif -%}
        <li data-material="{{ product.tags | join: ',' | escape }}">{% render 'product-card', product: product, lazy: card_lazy %}</li>
      {%- else -%}
        <li class="col-span-full text-center text-[#6b6b6b] py-20">No products found in this collection.</li>
      {%- endfor -%}
    </ul>

    <div class="text-center">
      {%- if paginate.next -%}
        <a data-collection-next href="{{ paginate.next.url }}" class="inline-block px-8 py-3 border border-[#111] text-xs tracking-widest uppercase text-[#111] hover:bg-[#111] hover:text-white transition-colors duration-200">Load More</a>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}
