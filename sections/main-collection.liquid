{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign products_per_page = section.settings.products_per_page | default: 24
-%}

<section class="py-16 px-6 lg:px-10 max-w-[1920px] mx-auto">
  {%- comment -%} Collection header {%- endcomment -%}
  <div class="mb-10 text-center">
    <h1 class="font-display text-5xl md:text-6xl font-light mb-4">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="text-[#6b6b6b] max-w-2xl mx-auto text-sm leading-relaxed">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Product grid {%- endcomment -%}
  {%- paginate collection.products by products_per_page -%}
    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6 mb-12">
      {%- for product in collection.products -%}
        <li>{% render 'product-card', product: product, lazy: forloop.index > 4 %}</li>
      {%- else -%}
        <li class="col-span-full text-center text-[#6b6b6b] py-20">No products found in this collection.</li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav aria-label="Pagination" class="flex justify-center gap-2">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="px-4 py-2 border border-[#2a2a2a] text-xs tracking-widest uppercase hover:border-[#fafafa] transition-colors duration-200">Prev</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="px-4 py-2 border border-[#2a2a2a] text-xs hover:border-[#fafafa] transition-colors duration-200">{{ part.title }}</a>
          {%- else -%}
            <span class="px-4 py-2 border border-[#c9a96e] text-[#c9a96e] text-xs">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="px-4 py-2 border border-[#2a2a2a] text-xs tracking-widest uppercase hover:border-[#fafafa] transition-colors duration-200">Next</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "label": "Products per page",
      "default": 24
    }
  ]
}
{% endschema %}
