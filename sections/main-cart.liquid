<section class="py-16 px-6 lg:px-10 max-w-4xl mx-auto">
  <h1 class="font-display text-5xl font-light mb-10">Your Cart</h1>

  {%- if cart.item_count == 0 -%}
    <div class="text-center py-20 flex flex-col gap-6 items-center">
      <p class="text-[#6b6b6b]">Your cart is empty.</p>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="text-xs tracking-widest uppercase border border-[#c9a96e] text-[#c9a96e] px-8 py-4 hover:bg-[#c9a96e] hover:text-[#0a0a0a] transition-colors duration-200"
      >
        Continue Shopping
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      <ul class="flex flex-col divide-y divide-[#2a2a2a] mb-10">
        {%- for item in cart.items -%}
          <li class="py-6 flex gap-6">
            <img
              src="{{ item.image | image_url: width: 160 }}"
              alt="{{ item.image.alt | escape | default: item.title | escape }}"
              width="100"
              height="120"
              loading="lazy"
              class="w-24 h-28 object-cover bg-[#111] shrink-0"
            >
            <div class="flex flex-col gap-1 flex-1">
              <p class="text-xs text-[#6b6b6b] tracking-widest uppercase">{{ item.vendor }}</p>
              <a href="{{ item.url }}" class="text-sm hover:text-[#c9a96e] transition-colors duration-200">{{ item.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="text-xs text-[#6b6b6b]">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="flex items-center justify-between mt-auto">
                <p class="text-sm">{{ item.final_line_price | money }}</p>
                <a
                  href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
                  class="text-xs text-[#6b6b6b] hover:text-red-400 transition-colors duration-200"
                >
                  Remove
                </a>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="flex flex-col gap-4 items-end max-w-sm ml-auto">
        <div class="flex justify-between w-full text-sm">
          <span class="text-[#6b6b6b]">Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-xs text-[#6b6b6b]">Taxes and shipping calculated at checkout.</p>
        <button
          type="submit"
          name="checkout"
          class="w-full py-4 bg-[#c9a96e] text-[#0a0a0a] text-xs tracking-widest uppercase font-medium hover:bg-[#e0c99a] transition-colors duration-200"
        >
          Checkout
        </button>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
