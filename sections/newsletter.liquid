<section class="py-[var(--spacing-section,6rem)] px-6 lg:px-10 border-t border-[#2a2a2a]">
  <div class="max-w-2xl mx-auto text-center flex flex-col gap-6">
    {%- if section.settings.eyebrow != blank -%}
      <p class="text-xs tracking-[0.3em] uppercase text-[#c9a96e]">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="font-display text-4xl md:text-5xl font-light">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="text-[#6b6b6b] text-base">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {% form 'customer', id: 'newsletter-form', class: 'flex flex-col sm:flex-row gap-0 max-w-md mx-auto w-full' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        type="email"
        name="contact[email]"
        id="newsletter-email"
        required
        autocomplete="email"
        placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
        class="
          flex-1 bg-transparent border border-[#2a2a2a] border-r-0
          px-5 py-4 text-sm text-[#fafafa] placeholder-[#6b6b6b]
          focus:outline-none focus:border-[#c9a96e]
          transition-colors duration-200
        "
      >
      <button
        type="submit"
        class="px-8 py-4 bg-[#c9a96e] text-[#0a0a0a] text-xs tracking-widest uppercase font-medium hover:bg-[#e0c99a] transition-colors duration-200 whitespace-nowrap"
      >
        {{ section.settings.button_label | default: 'Subscribe' }}
      </button>
    {% endform %}

    {%- if section.settings.disclaimer != blank -%}
      <p class="text-xs text-[#6b6b6b]">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe for early access to drops, exclusive offers and editorials."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By subscribing you agree to our Privacy Policy. Unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "heading": "Get 10% off your first order"
      }
    }
  ]
}
{% endschema %}
