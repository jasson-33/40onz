{%- comment -%}
  Atelier — banner (video / video URL / image) followed by an
  editorial workshop page. Blocks render in order:
  'heading' small uppercase label, 'paragraph' full-width text,
  'split' image left + text/columns right, 'image' full-bleed band,
  'video_row' three video thumbnails with play overlays.
{%- endcomment -%}

{%- liquid
  assign banner_height = section.settings.banner_height | default: 55
-%}

<section class="bg-white text-ink">
  {%- comment -%} ── Banner ──────────────────────────────────────────── {%- endcomment -%}
  <div
    class="relative w-full overflow-hidden bg-black"
    style="height: {{ banner_height }}vh; min-height: 420px;"
  >
    {%- if section.settings.video != blank -%}
      <video
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 2000 }}"
        {% endif %}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
      >
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif section.settings.video_url != blank -%}
      {%- assign video_url = section.settings.video_url -%}
      {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
        {%- liquid
          if video_url contains 'youtu.be/'
            assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first
          elsif video_url contains 'youtube.com/watch?v='
            assign yt_id = video_url | split: 'v=' | last | split: '&' | first
          elsif video_url contains 'youtube.com/shorts/'
            assign yt_id = video_url | split: 'shorts/' | last | split: '?' | first
          endif
        -%}
        <iframe
          src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&modestbranding=1&playsinline=1&rel=0&fs=0&disablekb=1&iv_load_policy=3&enablejsapi=1"
          allow="autoplay; encrypted-media"
          allowfullscreen
          frameborder="0"
          aria-hidden="true"
          tabindex="-1"
          class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        ></iframe>
      {%- elsif video_url contains 'vimeo.com' -%}
        {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
        <iframe
          src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&autopause=0&controls=0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          frameborder="0"
          aria-hidden="true"
          tabindex="-1"
          class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        width="2000"
        height="1125"
        alt="{{ section.settings.image.alt | escape | default: 'Atelier' }}"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center"
      >
    {%- endif -%}

    <div
      class="absolute inset-0 bg-black"
      style="opacity: {{ section.settings.overlay_opacity | default: 10 | divided_by: 100.0 }};"
    ></div>
  </div>

  {%- comment -%} ── Blocks ───────────────────────────────────────────── {%- endcomment -%}
  <div class="flex flex-col gap-16 lg:gap-20 pt-16 pb-20 lg:pt-20 lg:pb-28">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <h2 class="font-acumin text-2xl uppercase tracking-wider leading-8 font-light text-ash">
              {{ block.settings.heading }}
            </h2>
          </div>

        {%- when 'paragraph' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <div class="font-acumin font-extralight text-ink text-xl leading-6 tracking-wider space-y-5">
              {{ block.settings.body }}
            </div>
          </div>

        {%- when 'split' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-20">
              <div class="lg:col-span-2 relative aspect-[3/4] overflow-hidden bg-[#f0f0f0]">
                {%- if block.settings.video != blank -%}
                  <video
                    autoplay
                    muted
                    loop
                    playsinline
                    {% if block.settings.image != blank %}
                      poster="{{ block.settings.image | image_url: width: 1200 }}"
                    {% endif %}
                    aria-hidden="true"
                    tabindex="-1"
                    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                  >
                    {%- for source in block.settings.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- elsif block.settings.video_url != blank -%}
                  {%- assign split_video_url = block.settings.video_url -%}
                  {%- if split_video_url contains 'youtube.com' or split_video_url contains 'youtu.be' -%}
                    {%- liquid
                      if split_video_url contains 'youtu.be/'
                        assign yt_id = split_video_url | split: 'youtu.be/' | last | split: '?' | first
                      elsif split_video_url contains 'youtube.com/watch?v='
                        assign yt_id = split_video_url | split: 'v=' | last | split: '&' | first
                      elsif split_video_url contains 'youtube.com/shorts/'
                        assign yt_id = split_video_url | split: 'shorts/' | last | split: '?' | first
                      endif
                    -%}
                    <iframe
                      src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&modestbranding=1&playsinline=1&rel=0&fs=0&disablekb=1&iv_load_policy=3&enablejsapi=1"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      frameborder="0"
                      aria-hidden="true"
                      tabindex="-1"
                      class="absolute top-0 left-1/2 h-full aspect-video -translate-x-1/2 pointer-events-none"
                    ></iframe>
                  {%- elsif split_video_url contains 'vimeo.com' -%}
                    {%- assign vimeo_id = split_video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
                    <iframe
                      src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&autopause=0&controls=0"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      frameborder="0"
                      aria-hidden="true"
                      tabindex="-1"
                      class="absolute top-0 left-1/2 h-full aspect-video -translate-x-1/2 pointer-events-none"
                    ></iframe>
                  {%- endif -%}
                {%- elsif block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 1200 }}"
                    srcset="
                      {{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 900 }} 900w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(min-width: 1024px) 38vw, 90vw"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | escape | default: 'Atelier' }}"
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                  >
                {%- elsif block.settings.asset != blank -%}
                  <img
                    src="{{ block.settings.asset | asset_url }}"
                    width="788"
                    height="1044"
                    alt="{{ block.settings.asset | escape }}"
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                  >
                {%- elsif block.settings.image_url != blank -%}
                  <img
                    src="{{ block.settings.image_url }}"
                    width="900"
                    height="1200"
                    alt=""
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover' }}
                {%- endif -%}
              </div>
              <div class="lg:col-span-3 flex flex-col justify-between gap-10 font-acumin font-extralight text-ink text-xl leading-6 tracking-wider">
                {%- if block.settings.body != blank -%}
                  <div class="space-y-5">
                    {{ block.settings.body }}
                  </div>
                {%- endif -%}
                {%- if block.settings.column_left != blank or block.settings.column_right != blank -%}
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-12">
                    {%- if block.settings.column_left != blank -%}
                      <div class="space-y-5">
                        {{ block.settings.column_left }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.column_right != blank -%}
                      <div class="space-y-5">
                        {{ block.settings.column_right }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'image' -%}
          <div
            class="relative w-full overflow-hidden bg-[#f0f0f0] flex items-center"
            style="max-height: {{ block.settings.height | default: 810 }}px;"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w,
                  {{ block.settings.image | image_url: width: 2000 }} 2000w
                "
                sizes="100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | escape | default: 'Atelier' }}"
                loading="lazy"
                class="w-full h-auto"
              >
            {%- elsif block.settings.asset != blank -%}
              <img
                src="{{ block.settings.asset | asset_url }}"
                width="1927"
                height="811"
                alt="{{ block.settings.asset | escape }}"
                loading="lazy"
                class="w-full h-auto"
              >
            {%- elsif block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                width="1927"
                height="811"
                alt=""
                loading="lazy"
                class="w-full h-auto"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-auto' }}
            {%- endif -%}
          </div>

        {%- when 'video_row' -%}
          <div class="max-w-[1800px] mx-auto w-full px-6 lg:px-10" {{ block.shopify_attributes }}>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-6">
              {%- for i in (1..3) -%}
                {%- assign video_key = 'video_' | append: i -%}
                {%- assign video_url_key = 'video_url_' | append: i -%}
                {%- assign image_key = 'image_' | append: i -%}
                {%- assign cell_video = block.settings[video_key] -%}
                {%- assign cell_video_url = block.settings[video_url_key] -%}
                {%- assign cell_image = block.settings[image_key] -%}
                <div class="relative aspect-[4/5] overflow-hidden bg-black">
                  {%- if cell_video != blank -%}
                    <video
                      autoplay
                      muted
                      loop
                      playsinline
                      {% if cell_image != blank %}
                        poster="{{ cell_image | image_url: width: 800 }}"
                      {% endif %}
                      aria-hidden="true"
                      tabindex="-1"
                      class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                    >
                      {%- for source in cell_video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endfor -%}
                    </video>
                  {%- elsif cell_video_url != blank -%}
                    {%- if cell_video_url contains 'youtube.com' or cell_video_url contains 'youtu.be' -%}
                      {%- liquid
                        if cell_video_url contains 'youtu.be/'
                          assign yt_id = cell_video_url | split: 'youtu.be/' | last | split: '?' | first
                        elsif cell_video_url contains 'youtube.com/watch?v='
                          assign yt_id = cell_video_url | split: 'v=' | last | split: '&' | first
                        elsif cell_video_url contains 'youtube.com/shorts/'
                          assign yt_id = cell_video_url | split: 'shorts/' | last | split: '?' | first
                        endif
                      -%}
                      <iframe
                        src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&modestbranding=1&playsinline=1&rel=0&fs=0&disablekb=1&iv_load_policy=3&enablejsapi=1"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                        frameborder="0"
                        aria-hidden="true"
                        tabindex="-1"
                        class="absolute top-0 left-1/2 h-full aspect-video -translate-x-1/2 pointer-events-none"
                      ></iframe>
                    {%- elsif cell_video_url contains 'vimeo.com' -%}
                      {%- assign vimeo_id = cell_video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
                      <iframe
                        src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&autopause=0&controls=0"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                        frameborder="0"
                        aria-hidden="true"
                        tabindex="-1"
                        class="absolute top-0 left-1/2 h-full aspect-video -translate-x-1/2 pointer-events-none"
                      ></iframe>
                    {%- endif -%}
                  {%- elsif cell_image != blank -%}
                    <img
                      src="{{ cell_image | image_url: width: 800 }}"
                      width="{{ cell_image.width }}"
                      height="{{ cell_image.height }}"
                      alt="{{ cell_image.alt | escape | default: 'Atelier' }}"
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover"
                    >
                    <span class="absolute inset-0 flex items-center justify-center text-white" aria-hidden="true">
                      <svg class="w-6 h-6 drop-shadow" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Atelier",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Banner video",
      "info": "Shopify-hosted video. Takes priority over video URL and image."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Fallback if no Shopify-hosted video is set.",
      "default": "https://www.youtube.com/watch?v=pZ8HAi-bcRE&t=1s"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (fallback / poster)"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Banner height",
      "default": 55
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Banner overlay opacity",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Atelier"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
        }
      ]
    },
    {
      "type": "split",
      "name": "Image + text",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Shopify-hosted video. Takes priority over video URL and image."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Fallback if no Shopify-hosted video is set.",
          "default": "https://www.youtube.com/watch?v=pZ8HAi-bcRE&t=1s"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (fallback / poster)"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset filename",
          "info": "e.g. atelier-hands.jpg — served from assets/ via asset_url"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Image URL (fallback)"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body (top right)",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
        },
        {
          "type": "richtext",
          "id": "column_left",
          "label": "Column left (bottom)"
        },
        {
          "type": "richtext",
          "id": "column_right",
          "label": "Column right (bottom)"
        }
      ]
    },
    {
      "type": "image",
      "name": "Full-bleed image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Theme asset filename",
          "info": "e.g. atelier-band.jpg — served from assets/ via asset_url"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "Image URL (fallback)"
        },
        {
          "type": "range",
          "id": "height",
          "min": 200,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "label": "Max height",
          "default": 810
        }
      ]
    },
    {
      "type": "video_row",
      "name": "Video row (3-up)",
      "settings": [
        { "type": "video", "id": "video_1", "label": "Video 1" },
        {
          "type": "video_url",
          "id": "video_url_1",
          "label": "Video URL 1",
          "accept": ["youtube", "vimeo"],
          "info": "Fallback if no Shopify-hosted video is set.",
          "default": "https://www.youtube.com/watch?v=pZ8HAi-bcRE&t=1s"
        },
        { "type": "image_picker", "id": "image_1", "label": "Image 1 (poster / fallback)" },
        { "type": "video", "id": "video_2", "label": "Video 2" },
        {
          "type": "video_url",
          "id": "video_url_2",
          "label": "Video URL 2",
          "accept": ["youtube", "vimeo"],
          "info": "Fallback if no Shopify-hosted video is set.",
          "default": "https://www.youtube.com/watch?v=pZ8HAi-bcRE&t=1s"
        },
        { "type": "image_picker", "id": "image_2", "label": "Image 2 (poster / fallback)" },
        { "type": "video", "id": "video_3", "label": "Video 3" },
        {
          "type": "video_url",
          "id": "video_url_3",
          "label": "Video URL 3",
          "accept": ["youtube", "vimeo"],
          "info": "Fallback if no Shopify-hosted video is set.",
          "default": "https://www.youtube.com/watch?v=pZ8HAi-bcRE&t=1s"
        },
        { "type": "image_picker", "id": "image_3", "label": "Image 3 (poster / fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier",
      "blocks": [
        { "type": "heading" },
        { "type": "paragraph" },
        { "type": "split" },
        { "type": "image" },
        { "type": "paragraph" },
        { "type": "video_row" }
      ]
    }
  ]
}
{% endschema %}
