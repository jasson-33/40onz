{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="py-12 px-6 lg:px-10 max-w-[1920px] mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20">

    {%- comment -%} Media gallery {%- endcomment -%}
    <div class="flex flex-col gap-3">
      <div class="aspect-[3/4] overflow-hidden bg-[#111] relative">
        <img
          id="product-featured-image"
          src="{{ product.featured_media | image_url: width: 900 }}"
          alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
          width="{{ product.featured_media.preview_image.width }}"
          height="{{ product.featured_media.preview_image.height }}"
          loading="eager"
          class="w-full h-full object-cover"
        >
      </div>
      {%- if product.media.size > 1 -%}
        <div class="grid grid-cols-4 gap-2">
          {%- for media in product.media -%}
            <button
              class="aspect-[3/4] overflow-hidden bg-[#111] border border-transparent hover:border-[#c9a96e] transition-colors duration-200"
              aria-label="{{ media.alt | escape | default: product.title | escape }}"
            >
              <img
                src="{{ media | image_url: width: 200 }}"
                alt="{{ media.alt | escape }}"
                loading="lazy"
                class="w-full h-full object-cover"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="flex flex-col gap-6 lg:pt-4">
      <div>
        {%- if product.vendor -%}
          <p class="text-xs tracking-widest uppercase text-[#6b6b6b] mb-2">{{ product.vendor }}</p>
        {%- endif -%}
        <h1 class="font-display text-4xl md:text-5xl font-light leading-tight mb-4">{{ product.title }}</h1>
        <p class="text-xl text-[#fafafa]">
          {%- if product.price_varies -%}<span>From </span>{%- endif -%}
          <span class="{% if current_variant.compare_at_price > current_variant.price %}text-red-400{% endif %}">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="text-[#6b6b6b] text-base ml-2">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
        </p>
      </div>

      {%- comment -%} Variants {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div>
            <p class="text-xs tracking-widest uppercase text-[#6b6b6b] mb-3">
              {{ option.name }}: <span class="text-[#fafafa]" id="option-{{ forloop.index }}-selected">{{ option.selected_value }}</span>
            </p>
            <div class="flex flex-wrap gap-2">
              {%- for value in option.values -%}
                <button
                  class="px-4 py-2 border text-xs tracking-wide {% if option.selected_value == value %}border-[#c9a96e] text-[#c9a96e]{% else %}border-[#2a2a2a] text-[#6b6b6b] hover:border-[#fafafa] hover:text-[#fafafa]{% endif %} transition-colors duration-200"
                  data-option-value="{{ value | escape }}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      {%- comment -%} Add to cart {%- endcomment -%}
      <form action="/cart/add" method="post" data-add-to-cart>
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          {% unless current_variant.available %}disabled{% endunless %}
          class="w-full py-4 bg-[#c9a96e] text-[#0a0a0a] text-xs tracking-widest uppercase font-medium hover:bg-[#e0c99a] transition-colors duration-200 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {%- if current_variant.available -%}
            Add to Cart
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      </form>

      {%- comment -%} Description {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="prose prose-invert prose-sm text-[#6b6b6b] leading-relaxed border-t border-[#2a2a2a] pt-6">
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
