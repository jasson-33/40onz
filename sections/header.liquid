<header
  class="fixed top-0 left-0 right-0 z-30 w-full transition-all duration-300"
  data-header
  style="height: var(--header-h, 140px);"
  role="banner"
>
  <div
    data-mega-menu-overlay
    aria-hidden="true"
    class="fixed left-0 right-0 bottom-0 z-20 bg-black/45 backdrop-blur-sm opacity-0 aria-[hidden=false]:opacity-100 pointer-events-none transition-opacity duration-300"
    style="top: calc(var(--header-h, 140px) - 8px);"
  ></div>

  {%- comment -%} Gradient fade so header reads over hero image {%- endcomment -%}
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/50 to-transparent backdrop-blur-sm pointer-events-none"></div>

  <div class="relative z-30 h-full max-w-[1920px] mx-auto grid grid-cols-[1fr_auto_1fr] items-center h-full header-grid px-6 lg:px-10">

    {%- comment -%} Left column — nav links {%- endcomment -%}
    <nav class="hidden lg:flex items-center gap-8 justify-start" aria-label="Main navigation">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="relative">
            <a
              href="{{ link.url }}"
              data-mega-menu-trigger="{{ forloop.index }}"
              aria-expanded="false"
              aria-haspopup="true"
              class="menu-nav-item text-[11px] tracking-[0.22em] uppercase text-white/85 hover:text-white transition-colors duration-200"
            >
              {{ link.title }}
            </a>
            {% render 'mega-menu', menu: link.links, index: forloop.index %}
          </div>
        {%- else -%}
          <a
            href="{{ link.url }}"
            class="menu-nav-item text-[11px] tracking-[0.22em] uppercase text-white/85 hover:text-white transition-colors duration-200"
          >
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Center column — logo, always centered regardless of nav/icon widths {%- endcomment -%}
    <a
      href="{{ routes.root_url }}"
      class="flex items-center justify-center"
      aria-label="{{ shop.name }}"
    >
      {%- if section.settings.logo != blank -%}
        <img
          data-logo-default
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width | default: 200 }}"
          height="auto"
          loading="eager"
          class="h-9 w-auto object-contain transition-opacity duration-300"
        >
      {%- endif -%}
      {%- if section.settings.logo_scrolled != blank -%}
        <img
          data-logo-scrolled
          src="{{ section.settings.logo_scrolled | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width_scrolled | default: 150 }}"
          height="auto"
          loading="eager"
          class="max-w-[65px] max-h-[71px] w-auto h-auto object-contain opacity-0 absolute transition-opacity duration-300"
        >
      {%- endif -%}
      {%- if section.settings.logo == blank and section.settings.logo_scrolled == blank -%}
        <span class="font-display text-xl tracking-[0.3em] uppercase text-white">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Right column — language, search, cart, account {%- endcomment -%}
    <div class="flex items-center gap-6 justify-end">

      {%- comment -%} Language switcher {%- endcomment -%}
      {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
        <div class="hidden lg:flex items-center gap-1.5 text-xs tracking-[0.15em] uppercase text-white/70">
          {%- for lang in localization.available_languages -%}
            <a
              href="{{ lang.root_url }}"
              class="{% if lang.iso_code == request.locale.iso_code %}text-white{% else %}text-white/40 hover:text-white{% endif %} transition-colors duration-200"
              hreflang="{{ lang.iso_code }}"
            >
              {{ lang.iso_code | upcase }}
            </a>
            {%- unless forloop.last -%}<span class="text-white/30">/</span>{%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Search {%- endcomment -%}
      <a
        href="{{ routes.search_url }}"
        aria-label="Search"
        class="hidden lg:flex text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7.5" cy="7.5" r="5.5"/>
          <path d="M13 13l3 3"/>
        </svg>
      </a>

      {%- comment -%} Cart {%- endcomment -%}
      <button
        data-cart-open
        aria-label="Open cart, {{ cart.item_count }} items"
        class="relative flex text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14h14V6l-3-4z"/>
          <path d="M3 6h14"/>
          <path d="M13 10a3 3 0 01-6 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span
            data-cart-count
            class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#c9a96e] text-[#0a0a0a] text-[9px] font-semibold flex items-center justify-center"
          >
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </button>

      {%- comment -%} Account {%- endcomment -%}
      <a
        href="{{ routes.account_url }}"
        aria-label="Account"
        class="hidden lg:flex text-white/70 hover:text-white transition-colors duration-200"
      >
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="10" cy="6" r="4"/>
          <path d="M2 18c0-4.418 3.582-8 8-8s8 3.582 8 8"/>
        </svg>
      </a>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-label="Open menu"
        class="lg:hidden flex flex-col gap-1.5 text-white/80 hover:text-white transition-colors duration-200"
      >
        <span class="block w-5 h-px bg-current"></span>
        <span class="block w-5 h-px bg-current"></span>
        <span class="block w-3 h-px bg-current"></span>
      </button>
    </div>
  </div>

  {%- comment -%} Mobile nav drawer {%- endcomment -%}
  <nav
    data-mobile-nav
    aria-hidden="true"
    aria-label="Mobile navigation"
    class="
      lg:hidden fixed inset-0 top-0 z-20
      bg-[#0a0a0a] overflow-y-auto
      translate-x-full aria-[hidden=false]:translate-x-0
      transition-transform duration-300
      px-8 pt-28 pb-12 flex flex-col gap-8
    "
  >
    {%- for link in section.settings.menu.links -%}
      {%- if link.links.size > 0 -%}
        <div>
          <a
            href="{{ link.url }}"
            class="text-2xl font-display font-light tracking-[0.15em] uppercase hover:text-[#c9a96e] transition-colors duration-200"
          >
            {{ link.title }}
          </a>
          <ul class="flex flex-col gap-4 mt-4 pl-4">
            {%- for sublink in link.links -%}
              <li>
                <a href="{{ sublink.url }}" class="text-lg text-white/80 hover:text-[#c9a96e] transition-colors duration-200">
                  {{ sublink.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <a
          href="{{ link.url }}"
          class="text-2xl font-display font-light tracking-[0.15em] uppercase hover:text-[#c9a96e] transition-colors duration-200"
        >
          {{ link.title }}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</header>

{%- comment -%} Spacer only on non-hero pages (hero section is full-bleed under the fixed header) {%- endcomment -%}
{%- unless template == 'index' -%}
  <div style="height: var(--header-h, 140px);"></div>
{%- endunless -%}

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image (initial)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width (initial)",
      "default": 200
    },
    {
      "type": "image_picker",
      "id": "logo_scrolled",
      "label": "Logo image (scrolled)"
    },
    {
      "type": "range",
      "id": "logo_width_scrolled",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo width (scrolled)",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "Create nested menu items in Shopify Admin → Online Store → Navigation. Nested items will appear in the mega-menu."
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
