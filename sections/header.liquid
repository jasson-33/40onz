<header
  class="sticky top-0 z-30 w-full bg-[#0a0a0a]/95 backdrop-blur-md border-b border-[#2a2a2a]"
  style="height: var(--header-h, 60px);"
  role="banner"
>
  <div class="max-w-[1920px] mx-auto h-full flex items-center justify-between px-6 lg:px-10 relative">

    {%- comment -%} Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="flex items-center shrink-0" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width | default: 100 }}"
          height="auto"
          loading="eager"
          class="h-8 w-auto object-contain"
        >
      {%- else -%}
        <span class="font-display text-lg tracking-[0.2em] uppercase">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Desktop nav {%- endcomment -%}
    <nav class="hidden lg:flex items-center gap-8 absolute left-1/2 -translate-x-1/2" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links.size > 0 -%}
          <div class="relative">
            <button
              data-mega-menu-trigger="{{ link.title | handle }}"
              aria-expanded="false"
              aria-haspopup="true"
              class="text-xs tracking-widest uppercase hover:text-[#c9a96e] transition-colors duration-200 flex items-center gap-1"
            >
              {{ link.title }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M1 1l4 4 4-4"/>
              </svg>
            </button>
            {% render 'mega-menu', menu_item: link %}
          </div>
        {%- else -%}
          <a
            href="{{ link.url }}"
            class="text-xs tracking-widest uppercase hover:text-[#c9a96e] transition-colors duration-200{% if link.active %} text-[#c9a96e]{% endif %}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Icons (right side) {%- endcomment -%}
    <div class="flex items-center gap-4">

      {%- comment -%} Search {%- endcomment -%}
      <a href="{{ routes.search_url }}" aria-label="Search" class="hidden lg:flex text-[#6b6b6b] hover:text-[#fafafa] transition-colors duration-200">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="7.5" cy="7.5" r="5.5"/>
          <path d="M13 13l3 3"/>
        </svg>
      </a>

      {%- comment -%} Cart {%- endcomment -%}
      <button
        data-cart-open
        aria-label="Open cart, {{ cart.item_count }} items"
        class="relative flex text-[#6b6b6b] hover:text-[#fafafa] transition-colors duration-200"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14h14V6l-3-4z"/>
          <path d="M3 6h14"/>
          <path d="M13 10a3 3 0 01-6 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span
            data-cart-count
            class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#c9a96e] text-[#0a0a0a] text-[9px] font-semibold flex items-center justify-center"
          >
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </button>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-label="Open menu"
        class="lg:hidden flex flex-col gap-1.5 text-[#6b6b6b] hover:text-[#fafafa] transition-colors duration-200"
      >
        <span class="block w-5 h-px bg-current"></span>
        <span class="block w-5 h-px bg-current"></span>
        <span class="block w-3 h-px bg-current"></span>
      </button>
    </div>
  </div>

  {%- comment -%} Mobile nav drawer {%- endcomment -%}
  <nav
    data-mobile-nav
    aria-hidden="true"
    aria-label="Mobile navigation"
    class="
      lg:hidden fixed inset-0 top-[var(--header-h,60px)] z-20
      bg-[#0a0a0a] overflow-y-auto
      translate-x-full aria-[hidden=false]:translate-x-0
      transition-transform duration-300
      px-6 py-8 flex flex-col gap-6
    "
  >
    {%- for link in linklists[section.settings.menu].links -%}
      <a
        href="{{ link.url }}"
        class="text-base tracking-widest uppercase hover:text-[#c9a96e] transition-colors duration-200{% if link.active %} text-[#c9a96e]{% endif %}"
      >
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 100
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
