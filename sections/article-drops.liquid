{%- comment -%}
  Article Drops — drop/diary-style article page.
  Left col: title, date (custom.subtitle or publish date), article.content,
            credits (custom.credits, uppercase).
  Right col: custom.gallery_mixed media mosaic —
            row1: items 1-2 stacked left + item 3 tall right;
            row2: item 4 wide; row3+: items 5+ in thirds.
  Bottom: related articles from the same blog (5-up grid).
{%- endcomment -%}

{%- assign items = article.metafields.custom.gallery_mixed.value -%}
{%- assign credits = article.metafields.custom.credits.value -%}
{%- assign date_label = article.metafields.custom.subtitle.value -%}

{%- if date_label == blank -%}
  {%- assign date_label = article.published_at | date: '%b / %Y' -%}
{%- endif -%}

<article class="bg-white text-ink">
  <h1 class="sr-only">{{ article.title }}</h1>

  <div class="md:flex md:items-stretch px-6 lg:px-16 pt-16 lg:pt-24 pb-12 lg:pb-16 gap-8 lg:gap-12">
    {%- comment -%} Left column — meta + text {%- endcomment -%}
    <div class="w-full md:w-1/3 flex flex-col">
      <h2 class="font-acumin text-2xl uppercase tracking-wider leading-8 font-light text-ink">
        {{ article.title }}
      </h2>
      {%- if date_label != blank -%}
        <p class="mt-2 font-acumin text-xs uppercase tracking-wider font-light text-mid">
          {{ date_label }}
        </p>
      {%- endif -%}

      {%- if article.content != blank -%}
        <div class="mt-10 font-acumin text-sm leading-6 font-light text-ink space-y-6">
          {{ article.content }}
        </div>
      {%- endif -%}

      {%- if credits != blank -%}
        <div class="mt-10 font-acumin text-xs leading-5 uppercase tracking-wider font-light text-ink">
          {{ credits | newline_to_br }}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} Right column — media mosaic {%- endcomment -%}
    {%- if items != blank and items.size > 0 -%}
      <div class="w-full md:w-2/3 mt-10 md:mt-0">
        {%- comment -%} Row 1: 2 stacked left + 1 tall right {%- endcomment -%}
        <div class="md:flex md:h-[65vh]">
          <div class="md:w-1/2 flex flex-col md:h-full">
            {%- for item in items limit: 1 -%}
              <div class="relative aspect-[4/5] md:aspect-auto md:flex-1 overflow-hidden">
                {%- render 'article-media', item: item, alt: article.title -%}
              </div>
            {%- endfor -%}
            {%- for item in items offset: 1 limit: 1 -%}
              <div class="relative aspect-[4/5] md:aspect-auto md:flex-1 overflow-hidden">
                {%- render 'article-media', item: item, alt: article.title -%}
              </div>
            {%- endfor -%}
          </div>
          {%- for item in items offset: 2 limit: 1 -%}
            <div class="md:w-1/2 relative aspect-[4/5] md:aspect-auto md:h-full overflow-hidden">
              {%- render 'article-media', item: item, alt: article.title -%}
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Row 2: single wide {%- endcomment -%}
        {%- for item in items offset: 3 limit: 1 -%}
          <div class="relative aspect-video md:aspect-auto md:h-[45vh] overflow-hidden">
            {%- render 'article-media', item: item, alt: article.title -%}
          </div>
        {%- endfor -%}

        {%- comment -%} Row 3+: thirds {%- endcomment -%}
        <div class="md:flex md:flex-wrap">
          {%- for item in items offset: 4 -%}
            <div class="relative w-full aspect-[4/5] md:aspect-auto md:w-1/3 md:grow md:h-[45vh] overflow-hidden">
              {%- render 'article-media', item: item, alt: article.title -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Related drops {%- endcomment -%}
  {%- if blog != blank and blog.articles.size > 1 -%}
    <section class="border-t border-[#eee] px-6 lg:px-16 py-12 lg:py-16">
      <h2 class="font-acumin text-xs uppercase tracking-widest font-light text-mid mb-8 lg:mb-12">
        Read more
      </h2>
      <ul class="grid grid-cols-2 md:grid-cols-5 gap-2">
        {%- assign shown = 0 -%}
        {%- for rel in blog.articles -%}
          {%- if rel.id != article.id and shown < 5 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign rel_sub = rel.metafields.custom.subtitle.value -%}
            <li class="group">
              <a href="{{ rel.url }}" class="block">
                <div class="aspect-[4/5] overflow-hidden bg-[#f0f0f0]">
                  {%- if rel.image != blank -%}
                    <img
                      src="{{ rel.image | image_url: width: 800 }}"
                      srcset="
                        {{ rel.image | image_url: width: 400 }} 400w,
                        {{ rel.image | image_url: width: 600 }} 600w,
                        {{ rel.image | image_url: width: 800 }} 800w
                      "
                      sizes="(max-width: 768px) 50vw, 20vw"
                      width="{{ rel.image.width }}"
                      height="{{ rel.image.height }}"
                      alt="{{ rel.image.alt | escape | default: rel.title | escape }}"
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    >
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                  {%- endif -%}
                </div>
                <h3 class="mt-3 font-acumin text-xs uppercase tracking-widest font-light text-ink">
                  {{ rel.title }}
                </h3>
                <p class="mt-1 font-acumin text-xs font-light text-mid">
                  {%- if rel_sub != blank -%}
                    {{ rel_sub }}
                  {%- else -%}
                    {{ rel.published_at | date: '%b · %Y' }}
                  {%- endif -%}
                </p>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Article Drops",
  "settings": []
}
{% endschema %}
