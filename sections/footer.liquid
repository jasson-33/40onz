<footer class="bg-black text-[#b7b7b7]">

  {%- comment -%} Row 1 — service claims {%- endcomment -%}
  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-b border-white/10 max-w-[1920px] mx-auto">
    <li class="py-16 px-6 text-center text-[11px] tracking-[0.22em] uppercase text-white/80 border border-white/10">Bespoke · Care · Restoration</li>
    <li class="py-16 px-6 text-center text-[11px] tracking-[0.22em] uppercase text-white/80 border border-white/10 border-t-0 lg:border-t">Headquarter</li>
    <li class="py-16 px-6 text-center text-[11px] tracking-[0.22em] uppercase text-white/80 border border-white/10 border-t-0 lg:border-t">Shipping</li>
    <li class="py-16 px-6 text-center text-[11px] tracking-[0.22em] uppercase text-white/80 border border-white/10 border-t-0 lg:border-t">Worldwide Delivery</li>
  </ul>

  {%- comment -%} Row 2 — logo + legal + links {%- endcomment -%}
  <div class="flex flex-col md:flex-row items-center justify-around gap-10 md:gap-20 lg:gap-32 px-6 lg:px-10 py-20 border-b border-white/10 max-w-[1400px] mx-auto">
    <div class="flex items-center justify-center gap-4 sm:gap-10 shrink-0">
      <a href="{{ routes.root_url }}" class="text-white text-2xl font-display tracking-[0.08em] uppercase">
        {{ section.settings.logo_text | default: shop.name }}
      </a>
      <div class="text-[10px] leading-relaxed tracking-[0.12em] uppercase text-[#6b6b6b]">
        <p>© {{ shop.name }} · {{ 'now' | date: '%Y' }} · All rights reserved.</p>
        {%- if section.settings.address != blank -%}
          <p class="mt-3">{{ section.settings.address }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="flex flex-wrap gap-10 md:gap-14 lg:gap-20 justify-start items-start shrink-0">
      <div>
        <p class="text-[10px] tracking-[0.22em] uppercase text-white/60 mb-4">Contacts</p>
        <ul class="flex flex-col gap-2.5 text-[11px] tracking-[0.1em] uppercase">
          <li><a href="/pages/contact" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Contact</a></li>
          <li><a href="/pages/terms" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Terms and conditions</a></li>
          <li><a href="/pages/payment-methods" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Payment methods</a></li>
        </ul>
      </div>
      <div>
        <p class="text-[10px] tracking-[0.22em] uppercase text-white/60 mb-4">Warranty</p>
        <ul class="flex flex-col gap-2.5 text-[11px] tracking-[0.1em] uppercase">
          <li><a href="/pages/warranty" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Warranty</a></li>
          <li><a href="/policies/privacy-policy" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Privacy Policy</a></li>
        </ul>
      </div>
      <div>
        <p class="text-[10px] tracking-[0.22em] uppercase text-white/60 mb-4">Aftercare</p>
        <ul class="flex flex-col gap-2.5 text-[11px] tracking-[0.1em] uppercase">
          <li><a href="/pages/size-guide" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">Size Guide</a></li>
          <li><a href="/pages/how-to-return" class="text-[#9e9e9e] hover:text-white transition-colors duration-200">How to Return</a></li>
        </ul>
      </div>
    </div>
  </div>

  {%- comment -%} Row 3 — newsletter {%- endcomment -%}
  <div class="flex flex-col sm:flex-row sm:items-center gap-6 px-6 lg:px-10 py-20 max-w-[1920px] mx-auto">
    <p class="text-[11px] tracking-[0.22em] uppercase text-white/80 shrink-0">Newsletter</p>

    {%- form 'customer', class: 'flex items-stretch gap-3 w-full max-w-md' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        required
        placeholder="E-mail"
        aria-label="Email address"
        class="flex-1 bg-transparent border border-white/25 px-4 py-3 text-[11px] tracking-[0.12em] uppercase text-white placeholder:text-[#6b6b6b] focus:outline-none focus:border-white/60 transition-colors duration-200"
      >
      <button
        type="submit"
        class="bg-[#8a8a8a] hover:bg-white text-[#111] text-[10px] tracking-[0.22em] uppercase px-6 transition-colors duration-200"
      >
        Subscribe
      </button>
    {%- endform -%}

    {%- if section.settings.newsletter_text != blank -%}
      <p class="text-[10px] tracking-[0.08em] uppercase text-[#6b6b6b] max-w-md leading-relaxed">
        {{ section.settings.newsletter_text }}
      </p>
    {%- endif -%}
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Cuarenta Onzas"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Calle 10 #43A - 30 · El Poblado · MDE · Colombia"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Subscribe to our newsletter and join our circle of collectors. Receive invitations to events, collection launches, and concerts."
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
