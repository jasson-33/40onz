<section class="py-[var(--spacing-section,6rem)] overflow-hidden">

  {%- comment -%} Section header {%- endcomment -%}
  <div class="px-6 lg:px-10 max-w-[1920px] mx-auto mb-8 flex items-end justify-between">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="text-xs tracking-[0.3em] uppercase text-[#c9a96e] mb-2">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="font-display text-4xl md:text-5xl font-light">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    {%- comment -%} Carousel controls {%- endcomment -%}
    <div class="flex gap-3 shrink-0">
      <button
        data-carousel-prev
        aria-label="Previous"
        class="w-10 h-10 border border-[#2a2a2a] flex items-center justify-center text-[#6b6b6b] hover:border-[#fafafa] hover:text-[#fafafa] transition-colors duration-200 disabled:opacity-30 disabled:pointer-events-none"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M10 3L5 8l5 5"/>
        </svg>
      </button>
      <button
        data-carousel-next
        aria-label="Next"
        class="w-10 h-10 border border-[#2a2a2a] flex items-center justify-center text-[#6b6b6b] hover:border-[#fafafa] hover:text-[#fafafa] transition-colors duration-200 disabled:opacity-30 disabled:pointer-events-none"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 3l5 5-5 5"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} Carousel track {%- endcomment -%}
  <div data-carousel class="relative">
    <div data-carousel-track class="flex">
      {%- for block in section.blocks -%}
        <div
          data-carousel-slide
          class="min-w-full lg:min-w-[50%] xl:min-w-[33.333%] px-2 first:pl-6 lg:first:pl-10"
          {{ block.shopify_attributes }}
        >
          <div class="relative aspect-[3/4] overflow-hidden bg-[#111]">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 600 }} 600w,
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1000 }} 1000w
                "
                sizes="(max-width: 1024px) 100vw, 50vw"
                width="1000"
                height="1333"
                alt="{{ block.settings.image.alt | escape | default: block.settings.caption | escape }}"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              >
            {%- else -%}
              <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a]"></div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/70 to-transparent">
                <p class="text-sm text-[#fafafa]">{{ block.settings.caption }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Campaign"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Carousel",
      "settings": {
        "title": "The Campaign"
      },
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
