<section class="relative bg-black h-[300vh]" data-scroll-reveal>
  <div class="sticky top-0 h-screen overflow-hidden">

  {%- comment -%} Backdrop {%- endcomment -%}
  <div class="absolute inset-0" data-reveal-bg>
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        width="2000"
        height="1125"
        alt="{{ section.settings.image.alt | escape | default: '' }}"
        loading="lazy"
        class="w-full h-full object-cover opacity-40"
      >
    {%- elsif section.settings.image_url != blank -%}
      <img
        src="{{ section.settings.image_url }}"
        width="2000"
        height="1125"
        alt=""
        loading="lazy"
        class="w-full h-full object-cover opacity-40"
      >
    {%- endif -%}
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  {%- comment -%} Manifesto {%- endcomment -%}
  <div class="relative z-10 h-full flex flex-col items-center justify-center px-6">
    {%- if section.settings.eyebrow != blank -%}
      <p class="text-[10px] tracking-[0.3em] uppercase text-white/50 mb-10">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 data-reveal-text class="max-w-4xl text-center text-2xl md:text-3xl lg:text-[2rem] font-light leading-relaxed tracking-wide uppercase">
        {%- assign words = section.settings.heading | split: ' ' -%}
        {%- for word in words -%}
          <span data-reveal-word class="transition-opacity duration-300 text-white">{{ word }}</span>{{ ' ' }}
        {%- endfor -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_url | default: '/pages/about' }}"
        class="mt-14 text-[11px] tracking-[0.25em] uppercase text-white/80 border-b border-white/40 pb-1 hover:text-white hover:border-white transition-colors duration-200"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "Background image URL (fallback)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Manifesto"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Manifesto text",
      "default": "We defend imperfection as truth. Time invested as value. We don't renderize. We don't mass produce."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
