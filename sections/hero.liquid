<section
  class="relative w-full overflow-hidden"
  style="height: {{ section.settings.height }}vh; min-height: 500px;"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- comment -%} Background image {%- endcomment -%}
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="
        {{ section.settings.image | image_url: width: 800 }} 800w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w,
        {{ section.settings.image | image_url: width: 1600 }} 1600w,
        {{ section.settings.image | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-center"
    >
  {%- else -%}
    <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a]"></div>
  {%- endif -%}

  {%- comment -%} Overlay {%- endcomment -%}
  <div
    class="absolute inset-0"
    style="background: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="relative z-10 h-full flex flex-col justify-{{ section.settings.content_position }} items-{{ section.settings.content_alignment }} px-6 lg:px-20 pb-16 pt-8">
    <div class="max-w-3xl {% if section.settings.content_alignment == 'center' %}text-center{% elsif section.settings.content_alignment == 'end' %}text-right{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="text-xs tracking-[0.3em] uppercase text-[#c9a96e] mb-4">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-light leading-[1.05] mb-6 text-[#fafafa]">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="text-base md:text-lg text-[#fafafa]/80 mb-8 max-w-lg {% if section.settings.content_alignment == 'center' %}mx-auto{% endif %}">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url | default: '/collections/all' }}"
          class="inline-block border border-[#fafafa] text-[#fafafa] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[#fafafa] hover:text-[#0a0a0a] transition-colors duration-300"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 90
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "New Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "heading": "New Collection",
        "button_label": "Shop Now"
      }
    }
  ]
}
{% endschema %}
