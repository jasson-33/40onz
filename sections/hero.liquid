{%- liquid
  assign hero_height = section.settings.height | default: 100
  assign placeholder_url = 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=2000&q=80&auto=format&fit=crop'
-%}

<section
  class="relative w-full overflow-hidden"
  style="height: {{ hero_height }}vh; min-height: 600px;"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- comment -%} Background media — video first, then image, then placeholder {%- endcomment -%}
  {%- if section.settings.video != blank -%}
    {%- assign video_url = section.settings.video -%}
    {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
      {%- comment -%} Extract YouTube video ID {%- endcomment -%}
      {%- liquid
        if video_url contains 'youtu.be/'
          assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first
        elsif video_url contains 'youtube.com/watch?v='
          assign yt_id = video_url | split: 'v=' | last | split: '&' | first
        elsif video_url contains 'youtube.com/shorts/'
          assign yt_id = video_url | split: 'shorts/' | last | split: '?' | first
        endif
      -%}
      <iframe
        src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&mute=1&loop=1&playlist={{ yt_id }}&controls=0&modestbranding=1&playsinline=1&rel=0&fs=0"
        allow="autoplay; encrypted-media"
        allowfullscreen
        frameborder="0"
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 w-full h-full object-cover"
        style="width: 100%; height: 100%;"
      ></iframe>
    {%- elsif video_url contains 'vimeo.com' -%}
      {%- liquid
        assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first
      -%}
      <iframe
        src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1&autopause=0&controls=0"
        allow="autoplay; encrypted-media"
        allowfullscreen
        frameborder="0"
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 w-full h-full object-cover"
        style="width: 100%; height: 100%;"
      ></iframe>
    {%- endif -%}
  {%- elsif section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="
        {{ section.settings.image | image_url: width: 800 }} 800w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w,
        {{ section.settings.image | image_url: width: 1600 }} 1600w,
        {{ section.settings.image | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      width="2000"
      height="1125"
      alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-center"
    >
  {%- else -%}
    <img
      src="{{ placeholder_url }}"
      alt="Hero placeholder"
      width="2000"
      height="1125"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover object-center"
    >
  {%- endif -%}

  {%- comment -%} Overlay {%- endcomment -%}
  <div
    class="absolute inset-0"
    style="background: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ section.settings.overlay_opacity | default: 25 | divided_by: 100.0 }};"
  ></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="
    relative z-10 h-full
    flex flex-col
    justify-{{ section.settings.content_position | default: 'end' }}
    items-{{ section.settings.content_alignment | default: 'start' }}
    px-8 lg:px-16 pb-20 pt-32
  ">
    <div class="max-w-3xl {% if section.settings.content_alignment == 'center' %}text-center mx-auto{% elsif section.settings.content_alignment == 'end' %}text-right{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="text-[11px] tracking-[0.3em] uppercase text-[#c9a96e] mb-4">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="font-display text-6xl md:text-8xl lg:text-9xl font-light leading-[1] mb-8 text-white">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="text-base md:text-lg text-white/75 mb-10 max-w-lg">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url | default: routes.all_products_collection_url }}"
          class="inline-block border border-white/70 text-white text-[11px] tracking-[0.2em] uppercase px-10 py-4 hover:bg-white hover:text-[#0a0a0a] transition-colors duration-300"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "video_url",
      "id": "video",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "YouTube or Vimeo video URL. Takes priority over image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (fallback / poster)"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 100
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 25
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "New Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "heading": "New Collection",
        "button_label": "Shop Now",
        "height": 100,
        "overlay_opacity": 25
      }
    }
  ]
}
{% endschema %}
