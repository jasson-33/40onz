<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged &ldquo;{{ current_tags | join: ', ' }}&rdquo;{% endif %}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {%- comment -%} Canonical & OG {%- endcomment -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  {%- comment -%} Google Fonts {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  {%- comment -%} Adobe Fonts kit — Aktiv Grotesk (200–700 + italics) {%- endcomment -%}
  <link rel="stylesheet" href="https://use.typekit.net/ugo5zjj.css">

  {%- comment -%} Self-hosted variable fonts (Roslindale 200–900 opsz ital, Acumin 100–900) {%- endcomment -%}
  <style>
    @font-face {
      font-family: "Roslindale Variable";
      src: url({{ 'roslindale-variable.ttf' | asset_url }}) format("truetype");
      font-weight: 200 900;
      font-style: normal italic;
      font-display: swap;
    }
    @font-face {
      font-family: "Acumin Variable Concept";
      src: url({{ 'acumin-variable.otf' | asset_url }}) format("opentype");
      font-weight: 100 900;
      font-stretch: 50% 115%;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: "IBM Plex Mono";
      src: url({{ 'ibm-plex-mono.otf' | asset_url }}) format("opentype");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
  </style>

  {%- comment -%} Vite assets {%- endcomment -%}
  {% render 'vite-tag' with 'theme.css' %}
  {% render 'vite-tag' with 'theme.js' %}

  {{ content_for_header }}
</head>

<body class="bg-[#0a0a0a] text-[#fafafa]">

  {%- comment -%} Skip to content {%- endcomment -%}
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#c9a96e] focus:text-[#0a0a0a] focus:rounded">
    Skip to content
  </a>

  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  {%- comment -%} Cart & search drawers (rendered globally) {%- endcomment -%}
  {% render 'cart-drawer' %}
  {% render 'search-drawer' %}

  {%- comment -%} Cart & search overlays {%- endcomment -%}
  <div
    data-cart-overlay
    aria-hidden="true"
    class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300 aria-hidden:opacity-0 aria-hidden:pointer-events-none"
  ></div>
  <div
    data-search-overlay
    aria-hidden="true"
    class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300 aria-hidden:opacity-0 aria-hidden:pointer-events-none"
  ></div>

</body>
</html>
